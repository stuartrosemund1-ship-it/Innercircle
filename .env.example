# Copy to .env.local. Restart Expo after changing these.
# Project URL and the publishable key (Project Settings → API). The legacy anon key name also works.
# Never put the service role or secret key in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
